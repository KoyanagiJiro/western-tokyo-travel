---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getPublishedArticles } from '../lib/articles';

const articles = (await getPublishedArticles()).slice(0, 3);
---

<BaseLayout description="Independent travel, local history and walking beyond central Tokyo.">
  <section class="intro page-shell">
    <p class="eyebrow">Western Tokyo</p>
    <h1>Independent travel, local history and walking beyond central Tokyo.</h1>
    <p>Western Tokyo Walks looks closely at the places west of the city centre: their paths, histories, cultural landscapes and the practical choices involved in visiting them.</p>
  </section>
  <section class="page-shell section-block" aria-labelledby="latest-heading">
    <div class="section-heading">
      <h2 id="latest-heading">Latest articles</h2>
      <a href="/articles/">View all articles</a>
    </div>
    <div class="article-list">{articles.map((article) => <ArticleCard article={article} />)}</div>
  </section>
  <section class="page-shell section-block" aria-labelledby="explore-heading">
    <h2 id="explore-heading">Explore the region</h2>
    <div class="topic-grid">
      <div><h3>Walking</h3><p>Routes and landscapes considered at a human pace.</p></div>
      <div><h3>History & culture</h3><p>Local history and the physical places through which it can be read.</p></div>
      <div><h3>Travel planning</h3><p>Practical comparisons for independent visits when they are useful.</p></div>
    </div>
  </section>
</BaseLayout>
