---
import BaseLayout from './BaseLayout.astro';
import type { Article } from '../lib/articles';

interface Props { article: Article }
const { article } = Astro.props;
const { data } = article;
const published = data.publishDate.toLocaleDateString('en', { dateStyle: 'long' });
const updated = data.updatedDate?.toLocaleDateString('en', { dateStyle: 'long' });
---

<BaseLayout title={data.title} description={data.description} image={data.heroImage} imageAlt={data.heroAlt} type="article">
  <article class="article-page">
    <header class="article-header">
      <p class="eyebrow">{data.contentType}</p>
      <h1>{data.title}</h1>
      <p class="dek">{data.excerpt}</p>
      <p class="article-dates">
        Published <time datetime={data.publishDate.toISOString()}>{published}</time>
        {data.updatedDate && <> · Updated <time datetime={data.updatedDate.toISOString()}>{updated}</time></>}
      </p>
      {data.tags && <ul class="tag-list" aria-label="Topics">{data.tags.map((tag) => <li>{tag}</li>)}</ul>}
    </header>
    {data.heroImage && <figure class="hero-image"><img src={data.heroImage} alt={data.heroAlt} /><slot name="hero-caption" /></figure>}
    <div class="prose"><slot /></div>
    <aside class="related" aria-labelledby="related-heading">
      <h2 id="related-heading">Related articles</h2>
      <p>Related reading will be added when approved articles are available.</p>
    </aside>
  </article>
</BaseLayout>
